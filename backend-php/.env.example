# ── Base de datos MySQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_de_tu_bd
DB_USER=tu_usuario_bd
DB_PASS=your_db_password_here
DB_CHARSET=utf8mb4

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ── JWT ──────────────────────────────────────────────────────
# Generar con: php -r "echo base64_encode(random_bytes(64));"
JWT_SECRET=change_this_to_a_random_256_bit_secret_key_before_deploy
JWT_TTL_SECONDS=3600

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://catalogo.tiendaintima.com/api

CORS_ALLOWED_ORIGINS=https://catalogo.tiendaintima.com,http://localhost:4200

# ── AI Helper / Groq ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
